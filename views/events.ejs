<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container">
  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: 2.25rem; font-weight: 800; color: #fff;">Explore Events</h1>
    <p style="color: var(--text-muted);">Find tech conferences, concerts, workshops, and networking meetups near you.</p>
  </div>

  <%- include('partials/messages') %>

  <!-- Search & Filter Bar -->
  <div class="glass-panel" style="margin-bottom: 2.5rem; padding: 1.5rem;">
    <form action="/events" method="GET" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; align-items: end;">
      <div>
        <label for="search" class="form-label">Search Keyword</label>
        <input type="text" id="search" name="search" class="form-control" placeholder="Title, keyword, venue..." value="<%= queryParams.search || '' %>">
      </div>

      <div>
        <label for="category" class="form-label">Category</label>
        <select id="category" name="category" class="form-select">
          <option value="all">All Categories</option>
          <% ['technology', 'business', 'music', 'sports', 'education', 'workshop', 'conference', 'networking', 'cultural', 'other'].forEach(cat => { %>
            <option value="<%= cat %>" <%= queryParams.category === cat ? 'selected' : '' %>><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
          <% }); %>
        </select>
      </div>

      <div>
        <label for="location" class="form-label">Location</label>
        <input type="text" id="location" name="location" class="form-control" placeholder="City or online..." value="<%= queryParams.location || '' %>">
      </div>

      <div>
        <label for="maxPrice" class="form-label">Max Price ($)</label>
        <input type="number" id="maxPrice" name="maxPrice" class="form-control" placeholder="e.g. 100" value="<%= queryParams.maxPrice || '' %>">
      </div>

      <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="btn btn-primary" style="flex: 1;"><i class="fa-solid fa-filter"></i> Filter</button>
        <a href="/events" class="btn btn-secondary" title="Reset Filters"><i class="fa-solid fa-rotate-left"></i></a>
      </div>
    </form>
  </div>

  <!-- Events Grid -->
  <% if (events && events.length > 0) { %>
    <div class="event-grid">
      <% events.forEach(event => { %>
        <div class="event-card">
          <div class="event-card-header">
            <span class="category-tag"><%= event.category %></span>
            <span class="price-tag"><%= event.price === 0 ? 'FREE' : '$' + event.price %></span>
          </div>
          <div class="event-card-body">
            <h3 class="event-title"><%= event.title %></h3>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.25rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              <%= event.description %>
            </p>
            <div class="event-meta">
              <div class="event-meta-item">
                <i class="fa-regular fa-calendar-check" style="color: var(--accent-purple);"></i>
                <span><%= new Date(event.eventDate).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></span>
              </div>
              <div class="event-meta-item">
                <i class="fa-regular fa-clock" style="color: var(--accent-cyan);"></i>
                <span><%= event.startTime %> - <%= event.endTime %></span>
              </div>
              <div class="event-meta-item">
                <i class="fa-solid fa-location-dot" style="color: var(--accent-pink);"></i>
                <span><%= event.location %></span>
              </div>
              <div class="event-meta-item">
                <i class="fa-solid fa-users" style="color: var(--accent-emerald);"></i>
                <span>
                  <% if (event.registeredCount >= event.capacity) { %>
                    <strong style="color: var(--accent-rose);">SOLD OUT</strong>
                  <% } else { %>
                    <strong><%= event.capacity - event.registeredCount %></strong> seats remaining
                  <% } %>
                </span>
              </div>
            </div>
          </div>
          <div class="event-card-footer">
            <span style="font-size: 0.85rem; color: var(--text-muted);">Host: <%= event.organizer ? event.organizer.name : 'Organizer' %></span>
            <a href="/events/<%= event._id %>" class="btn btn-primary btn-sm">View Event</a>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (currentPage > 1) { %>
          <a href="/events?page=<%= currentPage - 1 %>&search=<%= queryParams.search || '' %>&category=<%= queryParams.category || '' %>" class="pagination-item"><i class="fa-solid fa-chevron-left"></i> Prev</a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/events?page=<%= i %>&search=<%= queryParams.search || '' %>&category=<%= queryParams.category || '' %>" class="pagination-item <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <a href="/events?page=<%= currentPage + 1 %>&search=<%= queryParams.search || '' %>&category=<%= queryParams.category || '' %>" class="pagination-item">Next <i class="fa-solid fa-chevron-right"></i></a>
        <% } %>
      </div>
    <% } %>

  <% } else { %>
    <div class="glass-panel" style="text-align: center; padding: 4rem 2rem;">
      <i class="fa-solid fa-magnifying-glass" style="font-size: 3rem; color: var(--text-dim); margin-bottom: 1rem;"></i>
      <h2>No Events Found</h2>
      <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Try adjusting your search criteria or filters.</p>
      <a href="/events" class="btn btn-secondary">Clear All Filters</a>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
