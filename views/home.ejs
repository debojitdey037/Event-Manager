<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container">
  <%- include('partials/messages') %>

  <!-- Hero Section -->
  <section class="glass-panel" style="padding: 4rem 2rem; text-align: center; margin-bottom: 3rem; background: linear-gradient(135deg, rgba(30,41,59,0.9), rgba(15,23,42,0.95)); border: 1px solid var(--border-hover);">
    <span class="category-tag" style="margin-bottom: 1rem; display: inline-block;">NEXT-GEN EVENT MANAGEMENT & TICKETING</span>
    <h1 style="font-size: 3rem; font-weight: 800; margin-bottom: 1rem; background: linear-gradient(135deg, #fff, #94a3b8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
      Empower Your Gatherings with EventSphere
    </h1>
    <p style="font-size: 1.15rem; color: var(--text-muted); max-width: 700px; margin: 0 auto 2rem auto;">
      Discover world-class tech conferences, workshops, concerts, and summits. Seamless registration, instant ticket verification, and sponsorship ecosystem.
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/events" class="btn btn-primary" style="padding: 0.9rem 2rem; font-size: 1.05rem;">
        <i class="fa-solid fa-compass"></i> Explore All Events
      </a>
      <% if (!locals.user) { %>
        <a href="/register" class="btn btn-secondary" style="padding: 0.9rem 2rem; font-size: 1.05rem;">
          <i class="fa-solid fa-user-plus"></i> Join EventSphere
        </a>
      <% } else if (user.role === 'organizer') { %>
        <a href="/events/create" class="btn btn-secondary" style="padding: 0.9rem 2rem; font-size: 1.05rem;">
          <i class="fa-solid fa-plus"></i> Create an Event
        </a>
      <% } %>
    </div>
  </section>

  <!-- Categories Grid -->
  <section style="margin-bottom: 3.5rem;">
    <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; text-align: center;">Popular Categories</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
      <a href="/events?category=technology" class="glass-panel" style="text-align: center; padding: 1.5rem 1rem;">
        <div style="font-size: 2rem; color: #c084fc; margin-bottom: 0.5rem;"><i class="fa-solid fa-laptop-code"></i></div>
        <div style="font-weight: 700; color: #fff;">Technology</div>
      </a>
      <a href="/events?category=business" class="glass-panel" style="text-align: center; padding: 1.5rem 1rem;">
        <div style="font-size: 2rem; color: #34d399; margin-bottom: 0.5rem;"><i class="fa-solid fa-chart-line"></i></div>
        <div style="font-weight: 700; color: #fff;">Business</div>
      </a>
      <a href="/events?category=workshop" class="glass-panel" style="text-align: center; padding: 1.5rem 1rem;">
        <div style="font-size: 2rem; color: #fbbf24; margin-bottom: 0.5rem;"><i class="fa-solid fa-chalkboard-user"></i></div>
        <div style="font-weight: 700; color: #fff;">Workshops</div>
      </a>
      <a href="/events?category=conference" class="glass-panel" style="text-align: center; padding: 1.5rem 1rem;">
        <div style="font-size: 2rem; color: #22d3ee; margin-bottom: 0.5rem;"><i class="fa-solid fa-users"></i></div>
        <div style="font-weight: 700; color: #fff;">Conferences</div>
      </a>
      <a href="/events?category=music" class="glass-panel" style="text-align: center; padding: 1.5rem 1rem;">
        <div style="font-size: 2rem; color: #f43f5e; margin-bottom: 0.5rem;"><i class="fa-solid fa-music"></i></div>
        <div style="font-weight: 700; color: #fff;">Music</div>
      </a>
    </div>
  </section>

  <!-- Featured Upcoming Events -->
  <section style="margin-bottom: 3rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.5rem; font-weight: 700; color: #fff;">Featured Events</h2>
      <a href="/events" class="nav-link">View All <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <% if (typeof featuredEvents !== 'undefined' && featuredEvents.length > 0) { %>
      <div class="event-grid">
        <% featuredEvents.forEach(event => { %>
          <div class="event-card">
            <div class="event-card-header">
              <span class="category-tag"><%= event.category %></span>
              <span class="price-tag"><%= event.price === 0 ? 'FREE' : '$' + event.price %></span>
            </div>
            <div class="event-card-body">
              <h3 class="event-title"><%= event.title %></h3>
              <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= event.description %>
              </p>
              <div class="event-meta">
                <div class="event-meta-item">
                  <i class="fa-regular fa-calendar-check"></i>
                  <span><%= new Date(event.eventDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                </div>
                <div class="event-meta-item">
                  <i class="fa-solid fa-location-dot"></i>
                  <span><%= event.location %></span>
                </div>
                <div class="event-meta-item">
                  <i class="fa-solid fa-users"></i>
                  <span><%= event.capacity - event.registeredCount %> seats available</span>
                </div>
              </div>
            </div>
            <div class="event-card-footer">
              <span style="font-size: 0.85rem; color: var(--text-muted);">By <%= event.organizer ? event.organizer.name : 'Organizer' %></span>
              <a href="/events/<%= event._id %>" class="btn btn-primary btn-sm">View Details</a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="glass-panel" style="text-align: center; padding: 3rem;">
        <i class="fa-solid fa-calendar-xmark" style="font-size: 3rem; color: var(--text-dim); margin-bottom: 1rem;"></i>
        <h3>No Approved Events Available Right Now</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Be the first organizer to submit a new event for moderation!</p>
        <% if (locals.user && user.role === 'organizer') { %>
          <a href="/events/create" class="btn btn-primary">Create Event</a>
        <% } %>
      </div>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
