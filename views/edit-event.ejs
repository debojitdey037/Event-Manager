<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container" style="max-width: 720px;">
  <div class="glass-panel" style="margin-top: 1rem;">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;">
      <h1 style="font-size: 2rem; font-weight: 800; color: #fff;">Edit Event Details</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Update details for "<%= event.title %>"</p>
    </div>

    <%- include('partials/messages') %>

    <form action="/events/<%= event._id %>/edit" method="POST">
      <div class="form-group">
        <label for="title" class="form-label">Event Title</label>
        <input type="text" id="title" name="title" class="form-control" value="<%= event.title %>" required>
      </div>

      <div class="form-group">
        <label for="category" class="form-label">Category</label>
        <select id="category" name="category" class="form-select" required>
          <% ['technology', 'business', 'music', 'sports', 'education', 'workshop', 'conference', 'networking', 'cultural', 'other'].forEach(cat => { %>
            <option value="<%= cat %>" <%= event.category === cat ? 'selected' : '' %>><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="description" class="form-label">Detailed Description</label>
        <textarea id="description" name="description" class="form-control" required><%= event.description %></textarea>
      </div>

      <div class="form-group">
        <label for="location" class="form-label">Location / Venue Address</label>
        <input type="text" id="location" name="location" class="form-control" value="<%= event.location %>" required>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="eventDate" class="form-label">Date</label>
          <input type="date" id="eventDate" name="eventDate" class="form-control" value="<%= event.eventDate ? new Date(event.eventDate).toISOString().split('T')[0] : '' %>" required>
        </div>

        <div class="form-group">
          <label for="startTime" class="form-label">Start Time</label>
          <input type="time" id="startTime" name="startTime" class="form-control" value="<%= event.startTime %>" required>
        </div>

        <div class="form-group">
          <label for="endTime" class="form-label">End Time</label>
          <input type="time" id="endTime" name="endTime" class="form-control" value="<%= event.endTime %>" required>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="capacity" class="form-label">Capacity (Max Seats)</label>
          <input type="number" id="capacity" name="capacity" class="form-control" min="1" value="<%= event.capacity %>" required>
        </div>

        <div class="form-group">
          <label for="price" class="form-label">Price ($ USD)</label>
          <input type="number" id="price" name="price" class="form-control" min="0" step="0.01" value="<%= event.price %>" required>
        </div>
      </div>

      <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem;">
        <a href="/events/<%= event._id %>" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
      </div>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
