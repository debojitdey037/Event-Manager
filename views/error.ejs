<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container" style="max-width: 640px; text-align: center; padding: 4rem 1rem;">
  <div class="glass-panel">
    <div style="font-size: 4rem; font-weight: 800; color: var(--accent-amber); margin-bottom: 0.5rem;">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <h1 style="font-size: 1.75rem; font-weight: 800; color: #fff; margin-bottom: 0.75rem;">
      <%= typeof errorTitle !== 'undefined' ? errorTitle : 'An Error Occurred' %>
    </h1>
    <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 2rem;">
      <%= typeof errorMessage !== 'undefined' ? errorMessage : 'Something went wrong while processing your request.' %>
    </p>

    <% if (typeof stack !== 'undefined' && stack) { %>
      <div style="text-align: left; background: rgba(0,0,0,0.5); padding: 1rem; border-radius: var(--radius-sm); font-family: monospace; font-size: 0.8rem; overflow-x: auto; margin-bottom: 2rem; color: #f43f5e;">
        <pre><%= stack %></pre>
      </div>
    <% } %>

    <div style="display: flex; gap: 1rem; justify-content: center;">
      <a href="javascript:history.back()" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Go Back</a>
      <a href="/" class="btn btn-primary"><i class="fa-solid fa-house"></i> Home Page</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
