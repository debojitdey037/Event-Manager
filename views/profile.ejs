<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container" style="max-width: 600px;">
  <div class="glass-panel" style="margin-top: 1rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;">
      <div>
        <h1 style="font-size: 1.75rem; font-weight: 800; color: #fff;">My Account Profile</h1>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Manage your profile information and credentials</p>
      </div>
      <span class="role-tag role-<%= user.role %>" style="font-size: 0.85rem; padding: 0.35rem 0.85rem;"><%= user.role %></span>
    </div>

    <%- include('partials/messages') %>

    <form action="/profile" method="POST" style="margin-bottom: 2rem;">
      <div class="form-group">
        <label for="name" class="form-label">Full Name</label>
        <input type="text" id="name" name="name" class="form-control" value="<%= user.name %>" required>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <input type="email" id="email" name="email" class="form-control" value="<%= user.email %>" required>
      </div>

      <div class="form-group">
        <label class="form-label">Account Role (Read-Only)</label>
        <input type="text" class="form-control" value="<%= user.role.toUpperCase() %>" disabled style="opacity: 0.7; cursor: not-allowed;">
        <span style="font-size: 0.75rem; color: var(--text-dim); margin-top: 0.25rem; display: block;">Roles can only be changed by platform administrators.</span>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%;">
        <i class="fa-solid fa-floppy-disk"></i> Update Profile
      </button>
    </form>

    <div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
      <div>
        <div style="font-weight: 700; color: #fff;">Account Password</div>
        <div style="font-size: 0.85rem; color: var(--text-muted);">Change your current password securely</div>
      </div>
      <a href="/change-password" class="btn btn-secondary btn-sm">
        <i class="fa-solid fa-key"></i> Change Password
      </a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
