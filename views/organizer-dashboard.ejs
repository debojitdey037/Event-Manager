<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container">
  <div class="dashboard-header">
    <div>
      <h1 class="dashboard-title">Organizer Control Center</h1>
      <p class="dashboard-subtitle">Manage your hosted events, ticket capacity, and attendee registrations</p>
    </div>
    <a href="/events/create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Create New Event</a>
  </div>

  <%- include('partials/messages') %>

  <!-- Stats Grid -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon stat-purple"><i class="fa-solid fa-calendar-days"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= stats.total %></span>
        <span class="stat-label">Total Events</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-amber"><i class="fa-solid fa-hourglass-half"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= stats.pending %></span>
        <span class="stat-label">Pending Moderation</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-green"><i class="fa-solid fa-circle-check"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= stats.approved %></span>
        <span class="stat-label">Approved & Active</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-rose"><i class="fa-solid fa-circle-xmark"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= stats.rejected %></span>
        <span class="stat-label">Rejected / Revision</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-cyan"><i class="fa-solid fa-ticket"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= stats.totalRegistrations %></span>
        <span class="stat-label">Total Registrations</span>
      </div>
    </div>
  </div>

  <!-- Events Data Table -->
  <div class="glass-panel" style="margin-bottom: 3rem;">
    <h2 style="font-size: 1.25rem; font-weight: 700; color: #fff; margin-bottom: 1.25rem;">My Managed Events</h2>

    <% if (events && events.length > 0) { %>
      <div class="data-table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Title & Category</th>
              <th>Date & Location</th>
              <th>Capacity</th>
              <th>Price</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% events.forEach(event => { %>
              <tr>
                <td>
                  <div style="font-weight: 700; color: #fff;"><%= event.title %></div>
                  <span class="category-tag" style="font-size: 0.7rem; padding: 0.15rem 0.4rem;"><%= event.category %></span>
                </td>
                <td>
                  <div><i class="fa-regular fa-calendar" style="color: var(--accent-purple);"></i> <%= new Date(event.eventDate).toLocaleDateString('en-US') %></div>
                  <div style="font-size: 0.85rem; color: var(--text-muted);"><%= event.location %></div>
                </td>
                <td>
                  <strong><%= event.registeredCount %></strong> / <%= event.capacity %>
                </td>
                <td><%= event.price === 0 ? 'Free' : '$' + event.price %></td>
                <td>
                  <span class="status-badge status-<%= event.status %>"><%= event.status %></span>
                  <% if (event.status === 'rejected' && event.rejectionReason) { %>
                    <div style="font-size: 0.75rem; color: var(--accent-rose); margin-top: 0.25rem;">Reason: <%= event.rejectionReason %></div>
                  <% } %>
                </td>
                <td>
                  <div style="display: flex; gap: 0.5rem;">
                    <a href="/events/<%= event._id %>" class="btn btn-secondary btn-sm" title="View"><i class="fa-solid fa-eye"></i></a>
                    <a href="/events/<%= event._id %>/edit" class="btn btn-primary btn-sm" title="Edit"><i class="fa-solid fa-pen-to-square"></i></a>
                    <form action="/events/<%= event._id %>/delete" method="POST" style="display: inline;" data-confirm="Are you sure you want to delete this event and all associated registrations?">
                      <button type="submit" class="btn btn-danger btn-sm" title="Delete"><i class="fa-solid fa-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 3rem 1rem;">
        <i class="fa-solid fa-folder-open" style="font-size: 2.5rem; color: var(--text-dim); margin-bottom: 1rem;"></i>
        <p style="color: var(--text-muted);">You haven't created any events yet.</p>
        <a href="/events/create" class="btn btn-primary" style="margin-top: 1rem;">Create Your First Event</a>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
