<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container">
  <div class="dashboard-header">
    <div>
      <h1 class="dashboard-title">User Management & Permissions</h1>
      <p class="dashboard-subtitle">Manage accounts, change roles, enable/disable users, or delete spam profiles</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Dashboard</a>
  </div>

  <%- include('partials/messages') %>

  <!-- Search & Filter Bar -->
  <div class="glass-panel" style="margin-bottom: 2rem; padding: 1.25rem;">
    <form action="/admin/users" method="GET" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
      <div style="flex: 2; min-width: 200px;">
        <label for="search" class="form-label">Search Users</label>
        <input type="text" id="search" name="search" class="form-control" placeholder="Search by name or email..." value="<%= queryParams.search || '' %>">
      </div>

      <div style="flex: 1; min-width: 150px;">
        <label for="role" class="form-label">Filter by Role</label>
        <select id="role" name="role" class="form-select">
          <option value="all">All Roles</option>
          <% ['organizer', 'attendee', 'moderator', 'sponsor', 'superadmin'].forEach(r => { %>
            <option value="<%= r %>" <%= queryParams.role === r ? 'selected' : '' %>><%= r %></option>
          <% }); %>
        </select>
      </div>

      <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        <a href="/admin/users" class="btn btn-secondary"><i class="fa-solid fa-rotate-left"></i> Reset</a>
      </div>
    </form>
  </div>

  <!-- Users Data Table -->
  <div class="glass-panel">
    <% if (users && users.length > 0) { %>
      <div class="data-table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>User Name & Email</th>
              <th>Current Role</th>
              <th>Status</th>
              <th>Registered</th>
              <th>Change Role</th>
              <th>Account Controls</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td>
                  <div style="font-weight: 700; color: #fff;"><%= u.name %></div>
                  <div style="font-size: 0.85rem; color: var(--text-muted);"><%= u.email %></div>
                </td>
                <td><span class="role-tag role-<%= u.role %>"><%= u.role %></span></td>
                <td>
                  <span class="status-badge <%= u.isActive ? 'status-approved' : 'status-rejected' %>">
                    <%= u.isActive ? 'Active' : 'Disabled' %>
                  </span>
                </td>
                <td style="font-size: 0.85rem; color: var(--text-muted);"><%= new Date(u.createdAt).toLocaleDateString('en-US') %></td>
                <td>
                  <form action="/admin/users/<%= u._id %>/role" method="POST" style="display: flex; gap: 0.4rem; align-items: center;">
                    <select name="role" class="form-select" style="padding: 0.35rem 0.5rem; font-size: 0.85rem; min-width: 120px;">
                      <% ['organizer', 'attendee', 'moderator', 'sponsor', 'superadmin'].forEach(r => { %>
                        <option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= r %></option>
                      <% }); %>
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm" title="Save Role"><i class="fa-solid fa-check"></i></button>
                  </form>
                </td>
                <td>
                  <div style="display: flex; gap: 0.5rem;">
                    <% if (u._id.toString() !== user._id.toString()) { %>
                      <form action="/admin/users/<%= u._id %>/toggle-status" method="POST" style="display: inline;">
                        <button type="submit" class="btn <%= u.isActive ? 'btn-warning' : 'btn-success' %> btn-sm">
                          <%= u.isActive ? 'Disable' : 'Enable' %>
                        </button>
                      </form>

                      <form action="/admin/users/<%= u._id %>/delete" method="POST" style="display: inline;" data-confirm="Are you sure you want to delete user <%= u.name %> and all their associated data?">
                        <button type="submit" class="btn btn-danger btn-sm" title="Delete User"><i class="fa-solid fa-trash"></i></button>
                      </form>
                    <% } else { %>
                      <span style="font-size: 0.8rem; color: var(--accent-emerald); font-weight: 700;">(Current You)</span>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a href="/admin/users?page=<%= currentPage - 1 %>&search=<%= queryParams.search || '' %>&role=<%= queryParams.role || '' %>" class="pagination-item"><i class="fa-solid fa-chevron-left"></i> Prev</a>
          <% } %>

          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="/admin/users?page=<%= i %>&search=<%= queryParams.search || '' %>&role=<%= queryParams.role || '' %>" class="pagination-item <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
          <% } %>

          <% if (currentPage < totalPages) { %>
            <a href="/admin/users?page=<%= currentPage + 1 %>&search=<%= queryParams.search || '' %>&role=<%= queryParams.role || '' %>" class="pagination-item">Next <i class="fa-solid fa-chevron-right"></i></a>
          <% } %>
        </div>
      <% } %>

    <% } else { %>
      <div style="text-align: center; padding: 3rem;">
        <i class="fa-solid fa-user-slash" style="font-size: 2.5rem; color: var(--text-dim); margin-bottom: 0.75rem;"></i>
        <p style="color: var(--text-muted);">No users matching your search filters.</p>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
