<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container">
  <div class="dashboard-header">
    <div>
      <h1 class="dashboard-title">Attendee Portal</h1>
      <p class="dashboard-subtitle">Welcome back, <%= user.name %>! Here are your active registrations and tickets</p>
    </div>
    <a href="/events" class="btn btn-primary"><i class="fa-solid fa-compass"></i> Discover Events</a>
  </div>

  <%- include('partials/messages') %>

  <!-- Stats Overview -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon stat-green"><i class="fa-solid fa-ticket"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= activeTickets.length %></span>
        <span class="stat-label">Active Tickets</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-rose"><i class="fa-solid fa-ban"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= cancelledTickets.length %></span>
        <span class="stat-label">Cancelled Passes</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-purple"><i class="fa-solid fa-calendar-check"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= registrations.length %></span>
        <span class="stat-label">Total Registrations</span>
      </div>
    </div>
  </div>

  <!-- Upcoming Tickets Section -->
  <div class="glass-panel" style="margin-bottom: 3rem;">
    <h2 style="font-size: 1.25rem; font-weight: 700; color: #fff; margin-bottom: 1.25rem;">My Active Event Tickets</h2>

    <% if (activeTickets && activeTickets.length > 0) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
        <% activeTickets.forEach(ticket => { %>
          <div style="background: rgba(15,23,42,0.6); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <span class="status-badge status-active"><i class="fa-solid fa-circle-check"></i> Active</span>
              <span style="font-family: monospace; font-size: 0.85rem; color: var(--accent-cyan); font-weight: 700;"><%= ticket.ticketId %></span>
            </div>

            <h3 style="font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: 0.75rem;"><%= ticket.event ? ticket.event.title : 'Event' %></h3>

            <% if (ticket.event) { %>
              <div style="font-size: 0.85rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.25rem;">
                <div><i class="fa-regular fa-calendar"></i> <%= new Date(ticket.event.eventDate).toLocaleDateString('en-US') %></div>
                <div><i class="fa-solid fa-location-dot"></i> <%= ticket.event.location %></div>
              </div>

              <div style="display: flex; gap: 0.5rem;">
                <a href="/tickets/<%= ticket._id %>" class="btn btn-secondary btn-sm" style="flex: 1;">View Ticket</a>
                <form action="/tickets/<%= ticket._id %>/cancel" method="POST" style="flex: 1;" data-confirm="Cancel registration?">
                  <button type="submit" class="btn btn-danger btn-sm" style="width: 100%;">Cancel</button>
                </form>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p style="color: var(--text-muted);">No active event registrations. Discover events to get tickets!</p>
    <% } %>
  </div>

  <!-- Recommended Events -->
  <% if (recommendedEvents && recommendedEvents.length > 0) { %>
    <div style="margin-bottom: 3rem;">
      <h2 style="font-size: 1.25rem; font-weight: 700; color: #fff; margin-bottom: 1.25rem;">Recommended Events for You</h2>
      <div class="event-grid">
        <% recommendedEvents.forEach(event => { %>
          <div class="event-card">
            <div class="event-card-header">
              <span class="category-tag"><%= event.category %></span>
              <span class="price-tag"><%= event.price === 0 ? 'FREE' : '$' + event.price %></span>
            </div>
            <div class="event-card-body">
              <h3 class="event-title"><%= event.title %></h3>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;"><%= event.location %></p>
            </div>
            <div class="event-card-footer">
              <a href="/events/<%= event._id %>" class="btn btn-primary btn-sm" style="width: 100%;">View & Register</a>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
